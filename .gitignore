# ═══════════════════════════════════════════════
#  Code Mentor — .gitignore
#  SECURITY CRITICAL: Never commit secrets!
# ═══════════════════════════════════════════════

# ── 🔐 SECRETS (NEVER COMMIT) ──
.env
.env.local
.env.development
.env.production
.env.staging
!.env.example
google-credentials.json
**/google-credentials*.json
**/service-account*.json
*.pem
*.key
*.p12

# ── Dependencies ──
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js ──
/.next/
/out/
/build
.next/

# ── Testing ──
/coverage

# ── Logs ──
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── OS / IDE ──
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# ── Deployment ──
.vercel

# ── TypeScript ──
*.tsbuildinfo
next-env.d.ts

deploy-instructions.md
